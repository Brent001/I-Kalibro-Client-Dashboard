# ==========================================================
# Example environment config for the client dashboard
# Copy this file to .env and replace the placeholder values.
# This mirrors the current client .env and the admin app's env setup.
# ==========================================================

# CRON secret used for scheduled jobs
# Generate with: openssl rand -hex 32
CRON_SECRET="<your_cron_secret>"

# PostgreSQL / Neon database connection
# Get this from Neon dashboard > Project > Connect > Connection string
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>/<db_name>?sslmode=require&channel_binding=require"

# JWT secrets
# Generate strong random values with: openssl rand -base64 32
JWT_SECRET="<your_jwt_secret>"
JWT_REFRESH_SECRET="<your_jwt_refresh_secret>"

# Upstash Redis
# Get from Upstash dashboard > Database > REST API section
UPSTASH_REDIS_REST_URL="https://<your_upstash_redis_host>"
UPSTASH_REDIS_REST_TOKEN="<your_upstash_redis_rest_token>"

# Backblaze B2 config
# Get from Backblaze B2 > Application Keys and bucket settings
VITE_BACKBLAZE_KEY_ID="<your_backblaze_key_id>"
VITE_BACKBLAZE_APPLICATION_KEY="<your_backblaze_application_key>"
VITE_BACKBLAZE_BUCKET_NAME="<your_backblaze_bucket_name>"
VITE_BACKBLAZE_BUCKET_ID="<your_backblaze_bucket_id>"
VITE_BACKBLAZE_BUCKET_REGION="<your_backblaze_region>"

# Encryption key for app-level encryption / token protection
# Use a secure random 32-byte value
VITE_ENCRYPTION_KEY="<your_encryption_key>"

# Resend API key
# Get from Resend dashboard > API Keys
VITE_RESEND_API_KEY="<your_resend_api_key>"

# Client-specific note:
# Keep all VITE_* values here because the client app reads them in-browser.
# These values are typically the same as those used by the admin app.
# If you already have the admin .env values, copy the matching ones here
# and replace only the secrets for the client environment.

# client side
